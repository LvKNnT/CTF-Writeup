#!/usr/bin/env sage
"""
Funny Helicopter Morphology - 1.

Unlike challenge 2 (see "../Funny Helicopter Morphology - 2/solve.sage"),
this uses the *hint* path: send EVALSUM before PARAMS. The server then
sets used_hint=true and later PARAMS returns encrypted_flag_1 instead of
encrypted_flag_2; EVALSUM discloses the two auxiliary samples of the
8-coefficient secret polynomial T directly:
    S_i = B_i * T + K_i      (i = 0, 1), all in the aux ring dim 8
B_i is printed as the full CRT-interpolated integer (so it must be
centered to recover its true ternary {-1,0,1} coefficients and then
reduced modulo one RNS tower prime to match S_i, which the server only
prints already-reduced modulo that same tower). The aux crypto context
uses fixed parameters (ring dim 8, plaintext modulus 65537, security
level "NotSet", multiplicative depth 2), so OpenFHE's RNS tower moduli
are deterministic across runs; the two tower primes are hardcoded below
(same values used to solve the original challenge).

Both S0 and S1 share the same unknown T. Eliminating T:
    C   := B0 * B1^-1                 (mod q, ring/convolution product)
    RHS := S0 - C * S1                (mod q, fully known)
    RHS === K0 - C * K1               (mod q)   <-- both sides small!

This is a small-error decoding (CVP) problem in the negacyclic ring of
dimension 8: build the lattice generated by q*I_8 (mod-q wraparound) and
the convolution matrix of C, LLL-reduce it, and use Babai's
nearest-plane algorithm to find the point closest to (-RHS, 0).

In practice C = B0*B1^-1 turns out to have an unusually large kernel of
short vectors (because B0, B1 are sparse/ternary), so the naive closest
point is *not* always the true (K0, K1) - there can be several
comparably small solutions. The CHALLENGE command leaks the first two
signed coefficients of the *combined* error vector as a free hint
(K0[0], K0[1] exactly), and T must come out sorted (the server always
sorts T before use) and inside [2^59, 2^60). We enumerate the closest
point plus small combinations of the short "kernel" basis vectors, keep
the candidates consistent with those constraints, and report the
resulting flag-body candidates for every survivor.

This mirrors the writeup's own description almost exactly ("enumerate
... for each guess, derive T, require it to be sorted and in range, and
check ... leaked K_0[0] and K_0[1]"): this is a noisy recovery, not a
one-shot unique answer, and the writeup itself notes several separate
live transcripts were needed and "intersected/scored" to agree on the
stable flag body. Run this against a couple of connections and compare
the printed candidates - the true flag text should show up consistently
while the random padding suffix (and any wrong candidates) will differ
between runs.

Usage: sage solve.sage
"""

import itertools
import re
from fractions import Fraction

from pwn import remote

HOST = "chall.blackpinker.com"
PORT = 20799  # NOTE: verify against the live scoreboard; this port was recorded during solving

N = 8  # aux ring dimension (x^8 + 1)
# The two RNS tower primes for the fixed aux BFVRNS context (ring dim 8,
# plaintext modulus 65537, HEStd_NotSet, depth 2). Deterministic given
# fixed parameters; recorded from the original solve.
TOWER0 = 1152921504606846577  # the tower GetPolyCoefficientsSigned(T) uses
TOWER1 = 1152921504606846097
AUX_FULL_MODULUS = TOWER0 * TOWER1
Q = TOWER0

T_MIN, T_MAX = 1 << 59, 1 << 60


# ==========================================
# Negacyclic ring helpers (dimension 8, x^8+1)
# ==========================================
def negacyclic_matrix(poly, mod):
    M = [[0] * N for _ in range(N)]
    for i in range(N):
        for j in range(N):
            k = (j - i) % N
            val = poly[k]
            if i + k >= N:
                val = -val
            M[i][j] = val % mod
    return M


def mat_vec_mod(M, v, mod):
    return [sum(M[i][j] * v[j] for j in range(len(v))) % mod for i in range(len(M))]


def mat_mat_mod(A, B, mod):
    n, m, p = len(A), len(B), len(B[0])
    return [[sum(A[i][k] * B[k][j] for k in range(m)) % mod for j in range(p)] for i in range(n)]


def mat_inverse_mod(M, mod):
    n = len(M)
    A = [row[:] + [1 if i == j else 0 for j in range(n)] for i, row in enumerate(M)]
    for col in range(n):
        piv = next((r for r in range(col, n) if A[r][col] % mod != 0), None)
        if piv is None:
            raise ValueError("matrix not invertible mod q")
        A[col], A[piv] = A[piv], A[col]
        inv = pow(A[col][col], -1, mod)
        A[col] = [(x * inv) % mod for x in A[col]]
        for r in range(n):
            if r != col and A[r][col] != 0:
                f = A[r][col]
                A[r] = [(A[r][c] - f * A[col][c]) % mod for c in range(2 * n)]
    return [row[n:] for row in A]


def center(val, mod):
    val = val % mod
    return val - mod if val > mod // 2 else val


# ==========================================
# Pure-Python LLL + Babai nearest plane (small dims only - fine for 16-dim)
# ==========================================
def lll(basis, delta=Fraction(99, 100)):
    B = [row[:] for row in basis]
    n = len(B)

    def gram_schmidt(B):
        Bs, mu = [], [[Fraction(0)] * n for _ in range(n)]
        for i in range(n):
            v = [Fraction(x) for x in B[i]]
            for j in range(i):
                mu[i][j] = sum(Fraction(a) * b for a, b in zip(B[i], Bs[j])) / sum(b * b for b in Bs[j])
                v = [v[k] - mu[i][j] * Bs[j][k] for k in range(len(v))]
            Bs.append(v)
        return Bs, mu

    Bs, mu = gram_schmidt(B)
    k = 1
    while k < n:
        for j in range(k - 1, -1, -1):
            q = round(mu[k][j])
            if q != 0:
                B[k] = [B[k][t] - q * B[j][t] for t in range(len(B[k]))]
                Bs, mu = gram_schmidt(B)
        if sum(x * x for x in Bs[k]) >= (delta - mu[k][k - 1] ** 2) * sum(x * x for x in Bs[k - 1]):
            k += 1
        else:
            B[k], B[k - 1] = B[k - 1], B[k]
            Bs, mu = gram_schmidt(B)
            k = max(k - 1, 1)
    return B


def babai_closest(B, target):
    n = len(B)
    dim = len(target)

    def gram_schmidt(B):
        Bs, mu = [], [[Fraction(0)] * n for _ in range(n)]
        for i in range(n):
            v = [Fraction(x) for x in B[i]]
            for j in range(i):
                mu[i][j] = sum(Fraction(a) * b for a, b in zip(B[i], Bs[j])) / sum(b * b for b in Bs[j])
                v = [v[k] - mu[i][j] * Bs[j][k] for k in range(len(v))]
            Bs.append(v)
        return Bs

    Bs = gram_schmidt(B)
    b = [Fraction(x) for x in target]
    for i in range(n - 1, -1, -1):
        c = round(sum(b[k] * Bs[i][k] for k in range(dim)) / sum(x * x for x in Bs[i]))
        if c:
            b = [b[k] - c * B[i][k] for k in range(dim)]
    return b  # residual = target - closest_lattice_point


# ==========================================
# Main
# ==========================================
def main():
    io = remote(HOST, PORT)
    io.recvline()

    print("[*] Sending EVALSUM before PARAMS to unlock the hint path...")
    io.sendline(b"EVALSUM")
    evalsum_data = io.recvuntil(b"S1: ").decode()
    s1_line = io.recvline().decode().strip()

    b0_arr = eval(re.search(r"B0: (\[.*?\])", evalsum_data).group(1))
    s0_arr = eval(re.search(r"S0: (\[.*?\])", evalsum_data).group(1))
    b1_arr = eval(re.search(r"B1: (\[.*?\])", evalsum_data).group(1))
    s1_arr = eval(s1_line)
    print(f"[+] B0={b0_arr}\n    S0={s0_arr}\n    B1={b1_arr}\n    S1={s1_arr}")

    print("[*] Sending PARAMS to fetch encrypted_flag_1...")
    io.sendline(b"PARAMS")
    io.recvuntil(b"Encrypted flag: ")
    encrypted_flag_1_hex = io.recvline().decode().strip()
    print(f"[+] encrypted_flag_1 = {encrypted_flag_1_hex[:32]}...")

    print("[*] Sending CHALLENGE 1 0 to fetch the leaked K0[0], K0[1]...")
    io.sendline(b"CHALLENGE 1 0")
    chall_data = io.recvall(timeout=3).decode(errors="replace")
    leaked = [int(x) for x in re.findall(r"E\[\d+\]: (-?\d+)", chall_data)]
    print(f"[+] Leaked signed error coeffs (K0[0], K0[1]): {leaked}")
    io.close()

    # ---- recover the true ternary B0, B1 from the CRT-interpolated values ----
    B0 = [center(v, AUX_FULL_MODULUS) % Q for v in b0_arr]
    B1 = [center(v, AUX_FULL_MODULUS) % Q for v in b1_arr]
    S0 = [v % Q for v in s0_arr]
    S1 = [v % Q for v in s1_arr]

    M_B0, M_B1 = negacyclic_matrix(B0, Q), negacyclic_matrix(B1, Q)
    M_B1inv = mat_inverse_mod(M_B1, Q)
    M_C = mat_mat_mod(M_B0, M_B1inv, Q)

    RHS = [(a - b) % Q for a, b in zip(S0, mat_vec_mod(M_C, S1, Q))]

    dim = 2 * N
    basis = [[0] * dim for _ in range(dim)]
    for i in range(N):
        basis[i][i] = Q
    for j in range(N):
        for i in range(N):
            basis[N + j][i] = M_C[i][j]
        basis[N + j][N + j] = 1

    print("[*] LLL-reducing the 16-dim CVP lattice...")
    B = lll(basis)

    target = [Fraction(-x) for x in RHS] + [Fraction(0)] * N
    residual = babai_closest(B, target)
    base_K0 = [-int(x) for x in residual[:N]]
    base_K1 = [-int(x) for x in residual[N:]]

    short_vecs = [row for row in B if sum(x * x for x in row) < 200]
    print(f"[*] {len(short_vecs)} short kernel vectors found; enumerating nearby candidates...")

    candidates = []
    if len(leaked) >= 2 and base_K0[0] == leaked[0] and base_K0[1] == leaked[1]:
        candidates.append((base_K0, base_K1))
    for combo in itertools.product(range(-2, 3), repeat=len(short_vecs)):
        if not any(combo):
            continue
        delta = [0] * dim
        for c, vec in zip(combo, short_vecs):
            if c:
                for i in range(dim):
                    delta[i] += c * vec[i]
        k0c = [base_K0[i] - delta[i] for i in range(N)]
        if len(leaked) >= 2 and (k0c[0] != leaked[0] or k0c[1] != leaked[1]):
            continue
        k1c = [base_K1[i] - delta[N + i] for i in range(N)]
        if all(abs(x) <= 12 for x in k0c) and all(abs(x) <= 12 for x in k1c):
            candidates.append((k0c, k1c))

    print(f"[*] {len(candidates)} candidates pass the leaked-K0 filter.")

    flags_seen = set()
    for k0c, k1c in candidates:
        S1_minus_K1 = [(s - k) % Q for s, k in zip(S1, k1c)]
        T_rec = mat_vec_mod(M_B1inv, S1_minus_K1, Q)
        if T_rec != sorted(T_rec) or not all(T_MIN <= x < T_MAX for x in T_rec):
            continue

        # server's signed packing centers each coefficient around Q/2 for this tower.
        signed_T = [center(t, Q) for t in T_rec]
        key_bytes = b"".join(int(t).to_bytes(8, "little", signed=True) for t in signed_T)

        enc_bytes = bytes.fromhex(encrypted_flag_1_hex)
        body = bytes(b ^ key_bytes[i % len(key_bytes)] for i, b in enumerate(enc_bytes))
        # cheap plausibility filter: real flag bytes are printable ASCII
        if not all(0x20 <= b < 0x7f for b in body):
            continue
        text = body.decode("ascii")
        flags_seen.add(text)

    print(f"[*] {len(flags_seen)} distinct printable-ASCII candidates.")
    for text in sorted(flags_seen)[:50]:
        print(f"    candidate flag body: {text}")
    if len(flags_seen) > 50:
        print(f"    ... and {len(flags_seen) - 50} more")

    print("\n[*] This recovery is inherently noisy (see the docstring above): rerun against")
    print("    a couple of fresh connections and keep whichever HCMUS-CTF{...} prefix stays")
    print("    stable across runs - per the writeup, only the trailing padding differs.")


if __name__ == "__main__":
    main()
