# permute has the following properties:
# permute(permute(x)) = x
# permute(a) ^ permute(b) = permute(a ^ b)
def permute(block):
    result = [0 for _ in range(8)]
    for i in range(8):
        x = block[i]
        for j in range(8):
            result[j] |= (x & 1) << i
            x >>= 1
    return result


def substitute(block):
    return [SBOX[x] for x in block]


def hash(data):
    if len(data) % 4 != 0:
        return None

    state = [16, 32, 48, 80, 80, 96, 112, 128]
    for i in range(0, len(data), 4):
        block = data[i:i+4]
        state[4] ^= block[0]
        state[5] ^= block[1]
        state[6] ^= block[2]
        state[7] ^= block[3]
        state = permute(state)
        state = substitute(state)

    for _ in range(16):
        state = permute(state)
        state = substitute(state)

    output = []
    for _ in range(2):
        output += state[4:]
        state = permute(state)
        state = substitute(state)

    return bytes(output)

msg1 = b"aaaa"

def permute_state(data):
    state = [16, 32, 48, 80, 80, 96, 112, 128]
    for i in range(0, len(data), 4):
        block = data[i:i+4]
        state[4] ^= block[0]
        state[5] ^= block[1]
        state[6] ^= block[2]
        state[7] ^= block[3]
        state = permute(state)

    return state

print(f"permute of msg1: {permute_state(msg1)}")
msg1_permuted = permute(permute_state(msg1))

target_xor = [ 240, 0, 0, 0, 93, 150, 136, 80 ]
target_xor = [177, 1, 145, 97]
state = [80, 96, 112, 128]
msg2 = b""
for i in range( 4 ):
    msg2 += bytes([target_xor[i] ^ state[i]])

print(f"msg2: {msg2}")
print({"msg1": msg1.hex(), "msg2": msg2.hex()})

io = remote(HOST, PORT)
io.recvuntil(b'dates."\n')
io.sendline(json.dumps({"a": msg1.hex(), "b" : msg2.hex()}).encode())
print(io.recvline())