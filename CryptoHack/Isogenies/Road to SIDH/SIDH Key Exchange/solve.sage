# CryptoHack - Road to SIDH - SIDH Key Exchange
#
# Both parties' secret keys are given, so we just need to implement the
# SIDH protocol (fill in gen_public_key / gen_shared_secret) and run it
# end to end to recover the shared secret, then decrypt the flag.

from Crypto.Cipher import AES
from Crypto.Hash import SHA256
from Crypto.Util.Padding import unpad

# Base field
ea, eb = 110, 67
p = 2**ea * 3**eb - 1
F = GF(p**2, names="i", modulus=[1, 0, 1])
i = F.gen()

# Public curve
E0 = EllipticCurve(F, [1, 0])

# Torsion points
P2 = E0(118242575052254473701407051403380184157502700009529430046122822477*i + 57638278144985143549644316704182130279784191379170896458696787312, 80915735815367072410310689908590367651933218830435520913424043510*i + 35228327576503752484578273317308597612913304063200715424014549037)
Q2 = E0(27856673727210297071672501895829918842041821446996051944738115273*i + 101349537690838191347553037323956940169953967852439843389873653018, 45955772915614774101614751673022340983778200451506382887743008335*i + 76499786039494489791183573966490259392789635716963920208794989512)
P3 = E0(68702305424425607424554396971378391833152415806389206440833676844*i + 63162905189208938201083385603424075109355856156240516441321158383, 14452401602439328239712793251073780692192036710425129093829067649*i + 110903430163815016394569999096524527007769669322432532390635606190)
Q3 = E0(50967992419888058158544483269655763559879646024537212566396940681*i + 39165103284419354968504615023980382940222714919046676966425620242, 113476160032430656302485251779124302915433268423829474022852380544*i + 74814862075401178218909769629701747112662266906635780085603780902)

# Secret keys
sA = 225902606209514408534212339057054
sB = 38410379124791756271891302485727


def push_isogeny(E, kernel_point, l, e, extra_points):
    """Compute the degree l^e isogeny with the given kernel by chaining e
    degree-l isogenies, pushing extra_points through at each step."""
    E_cur = E
    K_cur = kernel_point
    pts_cur = list(extra_points)
    for step in range(e):
        order_left = e - step
        ker_pt = (l**(order_left - 1)) * K_cur
        phi = E_cur.isogeny(ker_pt)
        K_cur = phi(K_cur)
        pts_cur = [phi(pt) for pt in pts_cur]
        E_cur = phi.codomain()
    return E_cur, K_cur, pts_cur


def gen_public_key(secret, l, e, own_P, own_Q, other_P, other_Q):
    kernel_point = own_P + secret * own_Q
    E_pub, _, (img_P, img_Q) = push_isogeny(E0, kernel_point, l, e, [other_P, other_Q])
    return E_pub, img_P, img_Q


def gen_shared_secret(secret, l, e, E_pub, img_P, img_Q):
    kernel_point = img_P + secret * img_Q
    E_shared, _, _ = push_isogeny(E_pub, kernel_point, l, e, [])
    return E_shared.j_invariant()


# Alice: 2^ea isogeny, kernel generated by P2 + sA*Q2
EA, PA3, QA3 = gen_public_key(sA, 2, ea, P2, Q2, P3, Q3)

# Bob: 3^eb isogeny, kernel generated by P3 + sB*Q3
EB, PB2, QB2 = gen_public_key(sB, 3, eb, P3, Q3, P2, Q2)

# Both sides compute the shared j-invariant
shared_secret_A = gen_shared_secret(sA, 2, ea, EB, PB2, QB2)
shared_secret_B = gen_shared_secret(sB, 3, eb, EA, PA3, QA3)

assert shared_secret_A == shared_secret_B
shared_secret = shared_secret_A
print("shared_secret =", shared_secret)

iv_hex = "05a4cfbce59acb952128af83c9694390"
ct_hex = "755b72b2e3bef2e7a4b2ce4a370f287ad04c1359bace25f3def8be23c0c49e89b4302408ad2dcb02d4875fe58c543d91"

key = SHA256.new(data=str(shared_secret).encode()).digest()[:128]
iv = bytes.fromhex(iv_hex)
ct = bytes.fromhex(ct_hex)

cipher = AES.new(key, AES.MODE_CBC, iv)
flag = unpad(cipher.decrypt(ct), 16)
print(flag)
